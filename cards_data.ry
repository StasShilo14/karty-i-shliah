{"name": "Трійка Пентаклів", "upright": "Командна робота, майстерність визнана іншими, хороша співпраця.", "reversed": "Розлад у команді, брак координації, недооцінена робота."},
{"name": "Четвірка Пентаклів", "upright": "Фінансова стабільність, але й тенденція тримати все під контролем.", "reversed": "Надмірна прив'язаність до грошей, страх втратити накопичене."},
{"name": "П'ятірка Пентаклів", "upright": "Фінансові труднощі чи відчуття нестачі, хоча допомога поруч.", "reversed": "Покращення після важкого періоду, відновлення ресурсів."},
{"name": "Шістка Пентаклів", "upright": "Щедрість, справедливий обмін, допомога що приходить у потрібний момент.", "reversed": "Нерівність в обміні, залежність від чужої милості."},
{"name": "Сімка Пентаклів", "upright": "Оцінка вкладених зусиль, час подивитись, чи варто продовжувати.", "reversed": "Нетерплячість щодо результатів, відчуття втраченого часу."},
{"name": "Вісімка Пентаклів", "upright": "Наполеглива праця та вдосконалення майстерності приносять плоди.", "reversed": "Недбала робота, брак мотивації вдосконалюватись."},
{"name": "Дев'ятка Пентаклів", "upright": "Незалежність та задоволення від власних досягнень.", "reversed": "Надмірна ізоляція заради роботи, фінансова залежність від інших."},
{"name": "Десятка Пентаклів", "upright": "Довготривала стабільність, спадщина, матеріальне благополуччя родини.", "reversed": "Фінансові суперечки в родині, нестабільна спадщина."},
{"name": "Паж Пентаклів", "upright": "Нова можливість навчання чи заробітку, практичний початок.", "reversed": "Відсутність дисципліни, нереалістичні фінансові плани."},
{"name": "Лицар Пентаклів", "upright": "Методичність, надійність, повільний та стабільний прогрес.", "reversed": "Застій через страх ризикувати, надмірна обережність."},
{"name": "Королева Пентаклів", "upright": "Практична турбота, вміння поєднувати роботу і затишок вдома.", "reversed": "Перевантаження побутовими турботами, знехтуване самопіклування."},
{"name": "Король Пентаклів", "upright": "Фінансова мудрість, стабільність через дисципліновану працю.", "reversed": "Матеріалізм, надмірна прив'язаність до статусу і грошей."},
]

FULL_DECK = MAJOR_ARCANA + MINOR_ARCANA # 78 карт разом
